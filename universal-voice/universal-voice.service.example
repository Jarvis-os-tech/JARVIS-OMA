[Unit]
Description=Standalone Universal Linux Voice
After=pipewire.service pipewire-pulse.service

[Service]
Type=simple
# Replace /ABSOLUTE/PATH/universal-voice with your extracted directory.
ExecStart="/ABSOLUTE/PATH/universal-voice/run.sh" run
EnvironmentFile=-%h/.config/universal-voice/env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
