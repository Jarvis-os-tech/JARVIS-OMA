{
  "network": {
    "check_gateway": true,
    "dns_targets": [
      "google.com",
      "1.1.1.1"
    ],
    "wan_urls": [
      "http://connectivitycheck.gstatic.com/generate_204",
      "https://1.1.1.1"
    ]
  },
  "servers": {
    "tcp": [],
    "http": []
  },
  "resources": {
    "cpu_threshold_percent": 85.0,
    "memory_threshold_percent": 80.0,
