      "pipewire.service",
      "wireplumber.service"
    ],
    "system": []
  },
  "alerts": {
    "cooldown_seconds": 300,
    "enable_voice": true,
    "voice_battery_only": true,
    "enable_sound_effects": false,
    "enable_desktop_notifications": true,
    "enable_audio": false
  }
