model = "gemini-3.8-live"
voice = "Aoede"
device = ""  # Microphone source
output_device = ""  # Speaker sink; empty uses system default
barge_in = true  # Natural interruptions: allow user speech to interrupt JARVIS
barge_in_min_rms = 0.004  # Minimum RMS voice threshold for barge-in detection
barge_in_echo_threshold = 0.45  # Correlation threshold to reject speaker echo
barge_in_vad_threshold = 0.50  # Silero VAD probability threshold for speech
autostart_listening = true
greet_on_start = true
turn_silence_frames = 100  # Wait for 2 seconds of silence; shorter pauses stay in the same sentence
language = "en-US"  # Spoken response language
language_codes = ["en-US", "en-IN", "en-GB"]  # Speech input transcription language hints
api_key_env = "GEMINI_API_KEY"

# Shared voice/control feature switches.
enable_tools = true
allow_shell = false
dry_run = false
tasks_enabled = true
vision_enabled = false

# Optional upstream settings; root switches above take precedence.
[control]
confirm_words = ["confirm", "yes do it", "go ahead"]

[control.tasks]
max_active = 1
# root = "/absolute/path/to/task-data"

[control.vision]
# Set vision_enabled = true above before using the camera.
# model = "your-vision-model"
# api_key_env = "OPENAI_API_KEY"
# base_url = "https://api.openai.com/v1"

[memory]
enabled = true
path = ""                               # Bridge default: $XDG_STATE_HOME/jarvis/memory
max_facts = 1000                         # Positive integer
context_max_chars = 6000                 # Positive integer
record_sessions = true                  # Continuous text memory
auto_capture = false                    # Requires a nonempty extraction_model
extraction_model = ""                   # Optional local Ollama model
extraction_url = "http://127.0.0.1:11434"
obsidian_vault = ""                     # Existing Obsidian vault path
obsidian_auto_sync = true               # Sync changes to linked Markdown notes
obsidian_timezone = "Asia/Kolkata"       # Calendar date/day for daily conversation reports
structured_capture = true               # Capture explicit user preferences/decisions/tasks locally
semantic_retrieval = false              # Opt in after choosing an embedding model/provider
semantic_provider = "gemini"            # Reuses GEMINI_API_KEY
semantic_model = ""                     # Example: text-embedding-004
semantic_url = "http://127.0.0.1:11434" # Used only when provider = "ollama"
semantic_dimension = 768                 # Must match the selected embedding model
semantic_min_score = 0.55               # Reject weak semantic-only matches

[standby]
enabled = true                           # Standby mode with local wake-word ("Hey Jarvis")
threshold = 0.50                         # Wake-word detection threshold (0.50 = 50% confidence)
vad_threshold = 0.50                     # Voice Activity Detection threshold to filter background noise
arming_delay = 1.0                       # Delay (seconds) before arming detector to prevent residual echo

[fillers]
# Enable instant local reflex loops bypassing cloud round-trip times
enable_local_fillers = true

# The directory holding pre-rendered or cached PCM snippets of your specific voice model
filler_audio_dir = "~/.local/share/jarvis-oma/audio/fillers/"

# Allowed variations for the token classifier to pick from randomly based on task categorization
phrases = [
    { text = "humm", file = "humm_thoughtful.pcm", duration_ms = 800, context = "generic_deep_thought" },
    { text = "wait a sec", file = "wait_sec_system.pcm", duration_ms = 1100, context = "system_mutation" },
    { text = "let's see", file = "lets_see_code.pcm", duration_ms = 950, context = "filesystem_grep" },
    { text = "give me a moment", file = "moment_agent.pcm", duration_ms = 1400, context = "sub_agent_spawn" }
]

# Audio mixing configurations for the Raised-Cosine transition inside downstream.py
[fillers.mixing]
ducking_window_ms = 50       # Time window to smoothly fade out the local filler when Gemini PCM arrives
local_buffer_precharge = 2   # Number of small audio chunks pre-loaded into RAM to eliminate disk wake latency


