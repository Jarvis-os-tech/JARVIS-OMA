#!/usr/bin/env bash
# bin/jarvis — Primary system control CLI for JARVIS OS
set -euo pipefail

SERVICE="jarvis-voice.service"
MONITOR_SERVICE="jarvis-monitor.service"
DRONE_SERVICE="jarvis-drone.service"
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

if [[ -f "${SCRIPT_DIR}/.env" ]]; then
    set -a
    # shellcheck disable=SC1091
    source "${SCRIPT_DIR}/.env"
    set +a
fi

show_help() {
    cat << 'EOF'
JARVIS OS System Control CLI

Usage:
  jarvis restart       Restart the JARVIS services
  jarvis disable       Disable and stop the JARVIS services
  jarvis enable        Enable and start the JARVIS services
  jarvis status        Show service status and live voice metrics
  jarvis start         Start the JARVIS services
  jarvis stop          Stop the JARVIS services
  jarvis logs [-f]     View JARVIS systemd logs
  jarvis monitor [cmd] System vitals & alerts (check|test-voice|test-audio|status|logs)
  jarvis listen [cmd]  Control voice listening (toggle|start|stop|cancel|confirm)
  jarvis standby       Enter private local standby (Hey Jarvis wakes)
  jarvis send [text]   Send typed query or command directly to live JARVIS session
  jarvis widgets [cmd] Canvas, QR, PiP and input widgets in the existing shell
  jarvis drone [cmd]   Visual holographic drone companion (start|stop|status|restart|appear|disappear|toggle|state|gesture)
  jarvis control [cmd] Desktop controlling & information retrieval (list|map|call)
  jarvis task [cmd]    Submit, inspect, read, cancel or resume durable work
  jarvis vision [cmd]  Camera start, inspect, status or stop
  jarvis say [text]    Typed request to the configured planner
  jarvis pair          Generate QR code to pair mobile companion app
  jarvis connect [app] Connect an external platform (e.g. github, slack, notion, spotify)
  jarvis platforms     List all connected external platforms
  jarvis history [N]   View continuous conversation history
  jarvis memory [cmd]  Memory inspection (stats|search|history|store)
  jarvis update [--check] Check or apply updates strictly from GitHub
  jarvis rollback      Instantly roll back to previous operational release
  jarvis releases      List all installed releases and active status
  jarvis mode [cmd]    Switch mode between test (workspace) and prod (standalone)
  jarvis lock [-y]     Lock the screen session with confirmation
  jarvis shutdown [-y] Shut down / power off the PC with confirmation
  jarvis reboot [-y]   Restart / reboot the PC with confirmation
  jarvis power [cmd]   System power & session lifecycle (shutdown|restart|lock|status|confirm|cancel)
  jarvis doctor [flags] Check and auto-repair JARVIS issues (temp & long-term)

EOF
}

cmd="${1:-}"

case "$cmd" in
    drone)
        shift || true
        exec "${SCRIPT_DIR}/bin/jarvis-drone" "$@"
        ;;
    widgets)
        shift || true
        exec "${SCRIPT_DIR}/bin/jarvis-widgets" "$@"
        ;;
    restart)
        echo "Restarting JARVIS..."
        systemctl --user restart "$SERVICE" 2>/dev/null || true
        systemctl --user restart "$MONITOR_SERVICE" 2>/dev/null || true
        systemctl --user restart "$DRONE_SERVICE" 2>/dev/null || true
        sleep 0.5
        active=$(systemctl --user is-active "$SERVICE" 2>/dev/null || true)
        m_active=$(systemctl --user is-active "$MONITOR_SERVICE" 2>/dev/null || true)
        d_active=$(systemctl --user is-active "$DRONE_SERVICE" 2>/dev/null || true)
        if [[ "$active" == "active" ]]; then
            echo "JARVIS Voice is active and running."
        else
            echo "JARVIS restart initiated. Status: ${active:-unknown}"
        fi
        if [[ "$m_active" == "active" ]]; then
            echo "JARVIS Monitor is active and running."
        fi
        if [[ "$d_active" == "active" ]]; then
            echo "JARVIS Drone Companion is active and running."
        fi
        ;;
    disable|disanble)
        echo "Disabling JARVIS services..."
        systemctl --user disable --now "$SERVICE" 2>/dev/null || true
        systemctl --user disable --now "$MONITOR_SERVICE" 2>/dev/null || true
        systemctl --user disable --now "$DRONE_SERVICE" 2>/dev/null || true
        echo "JARVIS services disabled and stopped."
        ;;
    enable)
        echo "Enabling JARVIS services..."
        systemctl --user enable --now "$SERVICE" 2>/dev/null || true
        systemctl --user enable --now "$MONITOR_SERVICE" 2>/dev/null || true
        systemctl --user enable --now "$DRONE_SERVICE" 2>/dev/null || true
        sleep 0.5
        active=$(systemctl --user is-active "$SERVICE" 2>/dev/null || true)
        m_active=$(systemctl --user is-active "$MONITOR_SERVICE" 2>/dev/null || true)
        d_active=$(systemctl --user is-active "$DRONE_SERVICE" 2>/dev/null || true)
        echo "Voice service: ${active:-inactive}, Monitor service: ${m_active:-inactive}, Drone service: ${d_active:-inactive}"
        ;;
    status)
        active=$(systemctl --user is-active "$SERVICE" 2>/dev/null || true)
        enabled=$(systemctl --user is-enabled "$SERVICE" 2>/dev/null || true)
        m_active=$(systemctl --user is-active "$MONITOR_SERVICE" 2>/dev/null || true)
        m_enabled=$(systemctl --user is-enabled "$MONITOR_SERVICE" 2>/dev/null || true)
        d_active=$(systemctl --user is-active "$DRONE_SERVICE" 2>/dev/null || true)
        d_enabled=$(systemctl --user is-enabled "$DRONE_SERVICE" 2>/dev/null || true)
        echo "Voice service:   ${active:-inactive} (enabled: ${enabled:-no})"
        echo "Monitor service: ${m_active:-inactive} (enabled: ${m_enabled:-no})"
        echo "Drone service:   ${d_active:-inactive} (enabled: ${d_enabled:-no})"
        if [[ "$active" == "active" ]]; then
            if [[ -x "${SCRIPT_DIR}/bin/jarvis-voice" ]]; then
                "${SCRIPT_DIR}/bin/jarvis-voice" status || true
            elif command -v jarvis-voice >/dev/null 2>&1; then
                jarvis-voice status || true
            fi
        fi
        ;;
    start)
        echo "Starting JARVIS..."
        systemctl --user start "$SERVICE" 2>/dev/null || true
        systemctl --user start "$MONITOR_SERVICE" 2>/dev/null || true
        systemctl --user start "$DRONE_SERVICE" 2>/dev/null || true
        sleep 0.5
        active=$(systemctl --user is-active "$SERVICE" 2>/dev/null || true)
        m_active=$(systemctl --user is-active "$MONITOR_SERVICE" 2>/dev/null || true)
        d_active=$(systemctl --user is-active "$DRONE_SERVICE" 2>/dev/null || true)
        echo "Voice status: ${active:-inactive}, Monitor status: ${m_active:-inactive}, Drone status: ${d_active:-inactive}"
        ;;
    stop)
        echo "Stopping JARVIS..."
        systemctl --user stop "$SERVICE" 2>/dev/null || true
        systemctl --user stop "$MONITOR_SERVICE" 2>/dev/null || true
        systemctl --user stop "$DRONE_SERVICE" 2>/dev/null || true
        active=$(systemctl --user is-active "$SERVICE" 2>/dev/null || true)
        m_active=$(systemctl --user is-active "$MONITOR_SERVICE" 2>/dev/null || true)
        d_active=$(systemctl --user is-active "$DRONE_SERVICE" 2>/dev/null || true)
        echo "Voice status: ${active:-inactive}, Monitor status: ${m_active:-inactive}, Drone status: ${d_active:-inactive}"
        ;;
    monitor)
        shift || true
        sub="${1:-}"
        case "$sub" in
            check|once)
                shift || true
                exec "${SCRIPT_DIR}/bin/jarvis-monitor" --once "$@"
                ;;
            test-voice|voice)
                shift || true
                exec "${SCRIPT_DIR}/bin/jarvis-monitor" --test-voice "$@"
                ;;
            test-audio|audio)
                shift || true
                exec "${SCRIPT_DIR}/bin/jarvis-monitor" --test-audio "$@"
                ;;
            status)
                shift || true
                systemctl --user status "$MONITOR_SERVICE" "$@"
                ;;
            logs)
                shift || true
                journalctl --user -u "$MONITOR_SERVICE" "$@"
                ;;
            *)
                exec "${SCRIPT_DIR}/bin/jarvis-monitor" "$@"
                ;;
        esac
        ;;
    logs)
        shift || true
        journalctl --user -u "$SERVICE" "$@"
        ;;
    listen)
        shift || true
        if [[ -x "${SCRIPT_DIR}/bin/jarvis-voice" ]]; then
            exec "${SCRIPT_DIR}/bin/jarvis-voice" listen "$@"
        else
            exec jarvis-voice listen "$@"
        fi
        ;;
    standby)
        shift || true
        if [[ -x "${SCRIPT_DIR}/bin/jarvis-voice" ]]; then
            exec "${SCRIPT_DIR}/bin/jarvis-voice" standby "$@"
        else
            exec jarvis-voice standby "$@"
        fi
        ;;
    wake)
        shift || true
        if [[ -x "${SCRIPT_DIR}/bin/jarvis-voice" ]]; then
            exec "${SCRIPT_DIR}/bin/jarvis-voice" wake "$@"
        else
            exec jarvis-voice wake "$@"
        fi
        ;;
    send|tell|prompt)
        shift || true
        if [[ -x "${SCRIPT_DIR}/bin/jarvis-voice" ]]; then
            exec "${SCRIPT_DIR}/bin/jarvis-voice" send "$@"
        else
            exec jarvis-voice send "$@"
        fi
        ;;
    pair)
        shift || true
        if [[ -x "${SCRIPT_DIR}/.venv/bin/python" ]]; then
            exec "${SCRIPT_DIR}/.venv/bin/python" "${SCRIPT_DIR}/scripts/jarvis_pair.py" "$@"
        else
            exec python3 "${SCRIPT_DIR}/scripts/jarvis_pair.py" "$@"
        fi
        ;;
    connect)
        shift || true
        if [[ -x "${SCRIPT_DIR}/.venv/bin/python" ]]; then
            exec "${SCRIPT_DIR}/.venv/bin/python" "${SCRIPT_DIR}/scripts/connect_composio.py" connect "$@"
        else
            exec python3 "${SCRIPT_DIR}/scripts/connect_composio.py" connect "$@"
        fi
        ;;
    platforms)
        shift || true
        if [[ -x "${SCRIPT_DIR}/.venv/bin/python" ]]; then
            exec "${SCRIPT_DIR}/.venv/bin/python" "${SCRIPT_DIR}/scripts/connect_composio.py" list "$@"
        else
            exec python3 "${SCRIPT_DIR}/scripts/connect_composio.py" list "$@"
        fi
        ;;
    history)
        shift || true
        export PYTHONPATH="${SCRIPT_DIR}:${PYTHONPATH:-}"
        if [[ -x "${SCRIPT_DIR}/.venv/bin/python" ]]; then
            exec "${SCRIPT_DIR}/.venv/bin/python" -m jarvis_memory history "$@"
        else
            exec python3 -m jarvis_memory history "$@"
        fi
        ;;
    memory)
        shift || true
        export PYTHONPATH="${SCRIPT_DIR}:${PYTHONPATH:-}"
        if [[ -x "${SCRIPT_DIR}/.venv/bin/python" ]]; then
            exec "${SCRIPT_DIR}/.venv/bin/python" -m jarvis_memory "$@"
        else
            exec python3 -m jarvis_memory "$@"
        fi
        ;;
    update)
        shift || true
        PYTHON="python3"
        if [[ -x "${HOME}/.local/share/jarvis-runtime/venv/bin/python" ]]; then
            PYTHON="${HOME}/.local/share/jarvis-runtime/venv/bin/python"
        elif [[ -x "${SCRIPT_DIR}/.venv/bin/python" ]]; then
            PYTHON="${SCRIPT_DIR}/.venv/bin/python"
        fi
        if [[ "${1:-}" == "--check" || "${1:-}" == "check" ]]; then
            exec "$PYTHON" "${SCRIPT_DIR}/scripts/jarvis_release.py" check
        else
            exec "$PYTHON" "${SCRIPT_DIR}/scripts/jarvis_release.py" update "$@"
        fi
        ;;
    rollback)
        shift || true
        PYTHON="python3"
        if [[ -x "${HOME}/.local/share/jarvis-runtime/venv/bin/python" ]]; then
            PYTHON="${HOME}/.local/share/jarvis-runtime/venv/bin/python"
        elif [[ -x "${SCRIPT_DIR}/.venv/bin/python" ]]; then
            PYTHON="${SCRIPT_DIR}/.venv/bin/python"
        fi
        exec "$PYTHON" "${SCRIPT_DIR}/scripts/jarvis_release.py" rollback "$@"
        ;;
    releases|release)
        shift || true
        PYTHON="python3"
        if [[ -x "${HOME}/.local/share/jarvis-runtime/venv/bin/python" ]]; then
            PYTHON="${HOME}/.local/share/jarvis-runtime/venv/bin/python"
        elif [[ -x "${SCRIPT_DIR}/.venv/bin/python" ]]; then
            PYTHON="${SCRIPT_DIR}/.venv/bin/python"
        fi
        exec "$PYTHON" "${SCRIPT_DIR}/scripts/jarvis_release.py" list "$@"
        ;;
    mode)
        shift || true
        PYTHON="python3"
        if [[ -x "${HOME}/.local/share/jarvis-runtime/venv/bin/python" ]]; then
            PYTHON="${HOME}/.local/share/jarvis-runtime/venv/bin/python"
        elif [[ -x "${SCRIPT_DIR}/.venv/bin/python" ]]; then
            PYTHON="${SCRIPT_DIR}/.venv/bin/python"
        fi
        exec "$PYTHON" "${SCRIPT_DIR}/scripts/jarvis_mode.py" "$@"
        ;;
    shutdown|poweroff)
        shift || true
        PYTHON="python3"
        if [[ -x "${HOME}/.local/share/jarvis-runtime/venv/bin/python" ]]; then
            PYTHON="${HOME}/.local/share/jarvis-runtime/venv/bin/python"
        elif [[ -x "${SCRIPT_DIR}/.venv/bin/python" ]]; then
            PYTHON="${SCRIPT_DIR}/.venv/bin/python"
        fi
        exec "$PYTHON" "${SCRIPT_DIR}/scripts/jarvis_power.py" shutdown "$@"
        ;;
    reboot)
        shift || true
        PYTHON="python3"
        if [[ -x "${HOME}/.local/share/jarvis-runtime/venv/bin/python" ]]; then
            PYTHON="${HOME}/.local/share/jarvis-runtime/venv/bin/python"
        elif [[ -x "${SCRIPT_DIR}/.venv/bin/python" ]]; then
            PYTHON="${SCRIPT_DIR}/.venv/bin/python"
        fi
        exec "$PYTHON" "${SCRIPT_DIR}/scripts/jarvis_power.py" restart "$@"
        ;;
    lock)
        shift || true
        PYTHON="python3"
        if [[ -x "${HOME}/.local/share/jarvis-runtime/venv/bin/python" ]]; then
            PYTHON="${HOME}/.local/share/jarvis-runtime/venv/bin/python"
        elif [[ -x "${SCRIPT_DIR}/.venv/bin/python" ]]; then
            PYTHON="${SCRIPT_DIR}/.venv/bin/python"
        fi
        exec "$PYTHON" "${SCRIPT_DIR}/scripts/jarvis_power.py" lock "$@"
        ;;
    power)
        shift || true
        PYTHON="python3"
        if [[ -x "${HOME}/.local/share/jarvis-runtime/venv/bin/python" ]]; then
            PYTHON="${HOME}/.local/share/jarvis-runtime/venv/bin/python"
        elif [[ -x "${SCRIPT_DIR}/.venv/bin/python" ]]; then
            PYTHON="${SCRIPT_DIR}/.venv/bin/python"
        fi
        exec "$PYTHON" "${SCRIPT_DIR}/scripts/jarvis_power.py" "$@"
        ;;
    control|task|vision|say|doctor)
        control_cmd="$cmd"
        shift || true
        if [[ "$control_cmd" != "control" ]]; then
            set -- "$control_cmd" "$@"
        fi
        if [[ -x "${SCRIPT_DIR}/bin/jarvis-control" ]]; then
            exec "${SCRIPT_DIR}/bin/jarvis-control" "$@"
        else
            exec jarvis-control "$@"
        fi
        ;;
    help|--help|-h|"")
        show_help
        ;;
    *)
        echo "Unknown command: $cmd" >&2
        show_help >&2
        exit 1
        ;;
esac
