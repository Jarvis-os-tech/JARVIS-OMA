#!/usr/bin/env bash
# bin/jarvis — Primary system control CLI for JARVIS OS
set -euo pipefail

SERVICE="jarvis-voice.service"
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

show_help() {
    cat << 'EOF'
JARVIS OS System Control CLI

Usage:
  jarvis restart       Restart the JARVIS service
  jarvis disable       Disable and stop the JARVIS service
  jarvis enable        Enable and start the JARVIS service
  jarvis status        Show service status and live voice metrics
  jarvis start         Start the JARVIS service
  jarvis stop          Stop the JARVIS service
  jarvis logs [-f]     View JARVIS systemd logs
  jarvis listen [cmd]  Control voice listening (toggle|start|stop|cancel|confirm)
  jarvis standby       Enter private local standby (Hey Jarvis wakes)
  jarvis send [text]   Send typed query or command directly to live JARVIS session
  jarvis control [cmd] Desktop controlling & information retrieval (list|map|call)
  jarvis task [cmd]    Submit, inspect, read, cancel or resume durable work
  jarvis vision [cmd]  Camera start, inspect, status or stop
  jarvis say [text]    Typed request to the configured planner
  jarvis pair          Generate QR code to pair mobile companion app
  jarvis history [N]   View continuous conversation history
  jarvis memory [cmd]  Memory inspection (stats|search|history|store)
  jarvis update [--check] Check or apply updates strictly from GitHub
  jarvis rollback      Instantly roll back to previous operational release
  jarvis releases      List all installed releases and active status
  jarvis doctor       Check JARVIS dependencies and enabled features

EOF
}

cmd="${1:-}"

case "$cmd" in
    restart)
        echo "Restarting JARVIS..."
        systemctl --user restart "$SERVICE"
        sleep 0.5
        active=$(systemctl --user is-active "$SERVICE" 2>/dev/null || true)
        if [[ "$active" == "active" ]]; then
            echo "JARVIS is active and running."
        else
            echo "JARVIS restart initiated. Status: ${active:-unknown}"
        fi
        ;;
    disable|disanble)
        echo "Disabling JARVIS service..."
        systemctl --user disable --now "$SERVICE"
        echo "JARVIS service disabled and stopped."
        ;;
    enable)
        echo "Enabling JARVIS service..."
        systemctl --user enable --now "$SERVICE"
        sleep 0.5
        active=$(systemctl --user is-active "$SERVICE" 2>/dev/null || true)
        if [[ "$active" == "active" ]]; then
            echo "JARVIS service enabled and active."
        else
            echo "JARVIS service enabled. Status: ${active:-inactive}"
        fi
        ;;
    status)
        active=$(systemctl --user is-active "$SERVICE" 2>/dev/null || true)
        enabled=$(systemctl --user is-enabled "$SERVICE" 2>/dev/null || true)
        echo "Service state: ${active:-inactive} (enabled: ${enabled:-no})"
        if [[ "$active" == "active" ]]; then
            if [[ -x "${SCRIPT_DIR}/bin/jarvis-voice" ]]; then
                "${SCRIPT_DIR}/bin/jarvis-voice" status || true
            elif command -v jarvis-voice >/dev/null 2>&1; then
                jarvis-voice status || true
            fi
        fi
        ;;
    start)
        echo "Starting JARVIS..."
        systemctl --user start "$SERVICE"
        sleep 0.5
        active=$(systemctl --user is-active "$SERVICE" 2>/dev/null || true)
        echo "Status: ${active:-inactive}"
        ;;
    stop)
        echo "Stopping JARVIS..."
        systemctl --user stop "$SERVICE"
        active=$(systemctl --user is-active "$SERVICE" 2>/dev/null || true)
        echo "Status: ${active:-inactive}"
        ;;
    logs)
        shift || true
        journalctl --user -u "$SERVICE" "$@"
        ;;
    listen)
        shift || true
        if [[ -x "${SCRIPT_DIR}/bin/jarvis-voice" ]]; then
            exec "${SCRIPT_DIR}/bin/jarvis-voice" listen "$@"
        else
            exec jarvis-voice listen "$@"
        fi
        ;;
    standby)
        shift || true
        if [[ -x "${SCRIPT_DIR}/bin/jarvis-voice" ]]; then
            exec "${SCRIPT_DIR}/bin/jarvis-voice" standby "$@"
        else
            exec jarvis-voice standby "$@"
        fi
        ;;
    wake)
        shift || true
        if [[ -x "${SCRIPT_DIR}/bin/jarvis-voice" ]]; then
            exec "${SCRIPT_DIR}/bin/jarvis-voice" wake "$@"
        else
            exec jarvis-voice wake "$@"
        fi
        ;;
    send|tell|prompt)
        shift || true
        if [[ -x "${SCRIPT_DIR}/bin/jarvis-voice" ]]; then
            exec "${SCRIPT_DIR}/bin/jarvis-voice" send "$@"
        else
            exec jarvis-voice send "$@"
        fi
        ;;
    pair)
        if [[ -x "${SCRIPT_DIR}/.venv/bin/python" ]]; then
            exec "${SCRIPT_DIR}/.venv/bin/python" "${SCRIPT_DIR}/scripts/jarvis_pair.py" "$@"
        else
            exec python3 "${SCRIPT_DIR}/scripts/jarvis_pair.py" "$@"
        fi
        ;;
    history)
        shift || true
        if [[ -x "${SCRIPT_DIR}/.venv/bin/python" ]]; then
            exec "${SCRIPT_DIR}/.venv/bin/python" -m jarvis_memory history "$@"
        else
            exec python3 -m jarvis_memory history "$@"
        fi
        ;;
    memory)
        shift || true
        if [[ -x "${SCRIPT_DIR}/.venv/bin/python" ]]; then
            exec "${SCRIPT_DIR}/.venv/bin/python" -m jarvis_memory "$@"
        else
            exec python3 -m jarvis_memory "$@"
        fi
        ;;
    update)
        shift || true
        PYTHON="python3"
        if [[ -x "${HOME}/.local/share/jarvis-runtime/venv/bin/python" ]]; then
            PYTHON="${HOME}/.local/share/jarvis-runtime/venv/bin/python"
        elif [[ -x "${SCRIPT_DIR}/.venv/bin/python" ]]; then
            PYTHON="${SCRIPT_DIR}/.venv/bin/python"
        fi
        if [[ "${1:-}" == "--check" || "${1:-}" == "check" ]]; then
            exec "$PYTHON" "${SCRIPT_DIR}/scripts/jarvis_release.py" check
        else
            exec "$PYTHON" "${SCRIPT_DIR}/scripts/jarvis_release.py" update "$@"
        fi
        ;;
    rollback)
        shift || true
        PYTHON="python3"
        if [[ -x "${HOME}/.local/share/jarvis-runtime/venv/bin/python" ]]; then
            PYTHON="${HOME}/.local/share/jarvis-runtime/venv/bin/python"
        elif [[ -x "${SCRIPT_DIR}/.venv/bin/python" ]]; then
            PYTHON="${SCRIPT_DIR}/.venv/bin/python"
        fi
        exec "$PYTHON" "${SCRIPT_DIR}/scripts/jarvis_release.py" rollback "$@"
        ;;
    releases|release)
        shift || true
        PYTHON="python3"
        if [[ -x "${HOME}/.local/share/jarvis-runtime/venv/bin/python" ]]; then
            PYTHON="${HOME}/.local/share/jarvis-runtime/venv/bin/python"
        elif [[ -x "${SCRIPT_DIR}/.venv/bin/python" ]]; then
            PYTHON="${SCRIPT_DIR}/.venv/bin/python"
        fi
        exec "$PYTHON" "${SCRIPT_DIR}/scripts/jarvis_release.py" list "$@"
        ;;
    control|task|vision|say|doctor)
        control_cmd="$cmd"
        shift || true
        if [[ "$control_cmd" != "control" ]]; then
            set -- "$control_cmd" "$@"
        fi
        if [[ -x "${SCRIPT_DIR}/bin/jarvis-control" ]]; then
            exec "${SCRIPT_DIR}/bin/jarvis-control" "$@"
        else
            exec jarvis-control "$@"
        fi
        ;;
    help|--help|-h|"")
        show_help
        ;;
    *)
        echo "Unknown command: $cmd" >&2
        show_help >&2
        exit 1
        ;;
esac
