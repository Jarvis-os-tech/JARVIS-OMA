#!/usr/bin/env bash
"exec" "/home/g0pi/JARVIS OS/.venv/bin/python" "$0" "$@"
import os
import sys
import tkinter as tk

def main():
    reason = os.environ.get("JARVIS_SUDO_REASON", "Administrative privileges required for this system action.")
    cmd = os.environ.get("JARVIS_SUDO_CMD", "")
    if not cmd and len(sys.argv) > 1:
        cmd = " ".join(sys.argv[1:])
    if not cmd:
        cmd = "systemctl / pacman administrative action"

    password = None

    try:
        root = tk.Tk(className="jarvis-askpass")
    except Exception as err:
        sys.stderr.write(f"jarvis-askpass: failed initializing display dialog: {err}\n")
        sys.exit(1)

    root.title("JARVIS Privileged Action")
    root.geometry("480x240")
    root.resizable(False, False)
    root.configure(bg="#181825")

    # Dark Palette (Catppuccin Mocha themed)
    BG = "#181825"
    CARD_BG = "#1e1e2e"
    TEXT_MAIN = "#cdd6f4"
    ACCENT = "#89b4fa"
    CMD_BG = "#11111b"
    BORDER = "#313244"
    BTN_BG = "#89b4fa"
    BTN_FG = "#11111b"
    BTN_CANCEL_BG = "#313244"

    # Container
    frame = tk.Frame(root, bg=BG, padx=16, pady=12)
    frame.pack(fill=tk.BOTH, expand=True)

    # Header
    hdr_frame = tk.Frame(frame, bg=BG)
    hdr_frame.pack(fill=tk.X, pady=(0, 6))

    icon_label = tk.Label(hdr_frame, text="🛡️", font=("Sans", 13), bg=BG, fg=ACCENT)
    icon_label.pack(side=tk.LEFT, padx=(0, 8))

    title_label = tk.Label(
        hdr_frame,
        text="JARVIS Privileged Action",
        font=("Sans", 12, "bold"),
        bg=BG,
        fg=ACCENT
    )
    title_label.pack(side=tk.LEFT)

    # Reason (Why it is needed)
    reason_label = tk.Label(
        frame,
        text=reason,
        font=("Sans", 10),
        bg=BG,
        fg=TEXT_MAIN,
        wraplength=440,
        justify=tk.LEFT
    )
    reason_label.pack(fill=tk.X, pady=(0, 6), anchor="w")

    # Command preview (dark monospaced box)
    cmd_frame = tk.Frame(frame, bg=CMD_BG, highlightbackground=BORDER, highlightthickness=1, padx=6, pady=4)
    cmd_frame.pack(fill=tk.X, pady=(0, 10))

    cmd_preview = f"$ {cmd}"
    if len(cmd_preview) > 65:
        cmd_preview = cmd_preview[:62] + "..."

    cmd_label = tk.Label(
        cmd_frame,
        text=cmd_preview,
        font=("Monospace", 9),
        bg=CMD_BG,
        fg="#a6e3a1",
        anchor="w"
    )
    cmd_label.pack(fill=tk.X)

    # Password input row
    input_frame = tk.Frame(frame, bg=BG)
    input_frame.pack(fill=tk.X, pady=(0, 10))

    pwd_entry = tk.Entry(
        input_frame,
        show="•",
        font=("Sans", 11),
        bg=CARD_BG,
        fg=TEXT_MAIN,
        insertbackground=ACCENT,
        highlightbackground=BORDER,
        highlightcolor=ACCENT,
        highlightthickness=1,
        relief=tk.FLAT
    )
    pwd_entry.pack(fill=tk.X, ipady=4)
    pwd_entry.focus_set()

    def on_submit(event=None):
        nonlocal password
        val = pwd_entry.get()
        pwd_entry.delete(0, tk.END)
        password = val
        root.destroy()

    def on_cancel(event=None):
        pwd_entry.delete(0, tk.END)
        root.destroy()

    # Buttons frame
    btn_frame = tk.Frame(frame, bg=BG)
    btn_frame.pack(fill=tk.X)

    cancel_btn = tk.Button(
        btn_frame,
        text="Cancel",
        font=("Sans", 9),
        bg=BTN_CANCEL_BG,
        fg=TEXT_MAIN,
        activebackground="#45475a",
        activeforeground=TEXT_MAIN,
        relief=tk.FLAT,
        padx=12,
        pady=3,
        command=on_cancel,
        cursor="hand2"
    )
    cancel_btn.pack(side=tk.RIGHT, padx=(6, 0))

    ok_btn = tk.Button(
        btn_frame,
        text="Authorize",
        font=("Sans", 9, "bold"),
        bg=BTN_BG,
        fg=BTN_FG,
        activebackground="#b4befe",
        activeforeground=BTN_FG,
        relief=tk.FLAT,
        padx=16,
        pady=3,
        command=on_submit,
        cursor="hand2"
    )
    ok_btn.pack(side=tk.RIGHT)

    # Key bindings
    root.bind("<Return>", on_submit)
    root.bind("<KP_Enter>", on_submit)
    root.bind("<Escape>", on_cancel)
    root.protocol("WM_DELETE_WINDOW", on_cancel)

    # Force keyboard grab and focus
    root.lift()
    root.attributes("-topmost", True)

    root.mainloop()

    if password is not None:
        sys.stdout.write(password + "\n")
        sys.stdout.flush()
        sys.exit(0)
    else:
        sys.exit(1)

if __name__ == "__main__":
    main()
