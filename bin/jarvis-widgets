#!/usr/bin/env python3
"""Send data to widgets in the existing desktop shell. Does not launch a GUI."""
from pathlib import Path
import runpy
import sys

root = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(root))
runpy.run_path(str(root / "ui/jarvis_widgets/backend.py"), run_name="__main__")
