[Unit]
Description=JARVIS Voice Assistant (Omarchy / Gemini Live)
Documentation=https://github.com/Jarvis-os-tech/JARVIS-OMA
PartOf=graphical-session.target
After=graphical-session.target pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
WorkingDirectory=/home/g0pi/Projects/JARVIS-OMA
ExecStart=/home/g0pi/Projects/JARVIS-OMA/run.sh
Restart=always
RestartSec=3s
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=10s

# Environment settings for Wayland, PipeWire and Omarchy desktop
Environment=PATH=/usr/share/omarchy/bin:/home/g0pi/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin
Environment=OMARCHY_PATH=/usr/share/omarchy
EnvironmentFile=-/home/g0pi/Projects/JARVIS-OMA/.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarvis

[Install]
WantedBy=graphical-session.target default.target
