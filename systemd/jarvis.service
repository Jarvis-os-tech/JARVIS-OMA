[Unit]
Description=JARVIS Voice Assistant (Omarchy / Gemini Live)
Documentation=https://github.com/Jarvis-os-tech/JARVIS-OMA
PartOf=graphical-session.target
After=graphical-session.target pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
WorkingDirectory=%h/Projects/JARVIS-OMA
ExecStart=%h/Projects/JARVIS-OMA/run.sh
Restart=always
RestartSec=3s
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=10s

# Normal process scheduling keeps startup independent of realtime privileges.

# Environment settings for Wayland, PipeWire and Omarchy desktop
Environment=PATH=/usr/share/omarchy/bin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin
Environment=OMARCHY_PATH=/usr/share/omarchy
Environment=PYTHONUNBUFFERED=1
Environment=PIPEWIRE_LATENCY=128/48000
Environment=PIPEWIRE_QUANTUM=128/48000
EnvironmentFile=-%h/Projects/JARVIS-OMA/.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarvis

[Install]
WantedBy=graphical-session.target default.target
