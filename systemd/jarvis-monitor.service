[Unit]
Description=JARVIS OS System Health & Audio Alert Monitor
After=pipewire.service wireplumber.service jarvis-voice.service
Wants=pipewire.service

[Service]
Type=simple
WorkingDirectory=%h/JARVIS OS
ExecStart="%h/JARVIS OS/bin/jarvis-monitor" --daemon --interval 15
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=XDG_RUNTIME_DIR=%t

[Install]
WantedBy=default.target
