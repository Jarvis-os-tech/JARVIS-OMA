# Gemini API Key (Required for live voice agent)
GEMINI_API_KEY="your-gemini-api-key-here"

# Autonomous agent budget routing. Set provider-supported model IDs.
# Budget goals fail before launch until Hermes and OpenCode models are set.
JARVIS_BUDGET_MODEL_HERMES=""
JARVIS_BUDGET_MODEL_OPENCODE=""
JARVIS_BUDGET_MODEL_CODEX="gpt-5.6-luna"
JARVIS_BUDGET_MODEL_CLAUDE="haiku"

# Gemini Live Model (Optional, defaults to gemini-3.8-live)
GEMINI_LIVE_MODEL="gemini-3.8-live"

# Optional general web search fallback when Gemini grounded Search has no quota.
# Obtain a key from Brave Search API and set this to enable current web results.
BRAVE_SEARCH_API_KEY=""

# Google Workspace OAuth (optional connector)
# Configure this exact authorized redirect URI in Google Cloud Console:
# http://localhost:8085/callback
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth (optional connector)
# Configure this callback in the GitHub OAuth App:
# http://localhost:3000/api/connectors/callback
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
